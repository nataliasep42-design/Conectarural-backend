# ConectaRural Backend — Plantilla de variables de entorno
# Copiar como .env y rellenar los valores reales. NUNCA subir .env a git.

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # cambiar a "production" en Render

# ── PostgreSQL (desarrollo local) ────────────────────────────────────────────
# En producción Render inyecta DATABASE_URL automáticamente; estas vars
# solo se usan cuando DATABASE_URL no está definida.
PGHOST=localhost
PGPORT=5432
PGDATABASE=conectarural_db
PGUSER=conectarural_user
PGPASSWORD=

# ── PostgreSQL (producción — Render la inyecta sola, no tocar) ───────────────
# DATABASE_URL=postgres://user:password@host:5432/database

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL exacta del panel de administración desplegado en Firebase Hosting.
# Ejemplo: https://conectarural-26759.web.app
ALLOWED_ORIGIN=

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
# JSON de cuenta de servicio en una sola línea (sin saltos de línea reales).
# Obtener en: Firebase Console → Configuración del proyecto → Cuentas de servicio
#             → Generar nueva clave privada
FCM_SERVICE_ACCOUNT_JSON=
